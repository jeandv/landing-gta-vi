---
import Layout from '../layouts/Layout.astro'
import HeroKeylogo from '../assets/hero-key-logo.webp'
---

<Layout>
  <section class='bg-black h-screen'>
    <section>
      <picture>
        <img 
					id="hero-key-logo"
					src={HeroKeylogo.src}
					class="absolute w-full h-full object-cover"
				/>
      </picture>
    </section>
  </section>
</Layout>
